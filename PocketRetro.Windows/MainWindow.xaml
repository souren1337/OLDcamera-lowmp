<Window x:Class="PocketRetro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketRetro Camera" Height="900" Width="1180" MinHeight="760" MinWidth="980"
        Background="#101719" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="POCKETRETRO" FontSize="25" FontWeight="Bold" Foreground="#D7E4BC" />
        <TextBlock Text="DIGITAL MEMORIES // 1988 — 2005" FontSize="10" Foreground="#899D86" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Text="WINDOWS EDITION  •  01" VerticalAlignment="Center" Foreground="#899D86" FontSize="11" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#202B29" BorderBrush="#52624F" BorderThickness="1" CornerRadius="18" Padding="15" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="VIEWFINDER" FontSize="11" Foreground="#B7D96C" />
            <TextBlock x:Name="CameraStateText" Text="CAMERA SEARCHING…" DockPanel.Dock="Right" FontSize="10" Foreground="#93A28D" />
          </DockPanel>
          <Border Grid.Row="1" Background="#101918" BorderBrush="#6A7C67" BorderThickness="2" CornerRadius="9" Padding="6">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="EmptyCameraMessage">
                <TextBlock Text="POCKETRETRO" FontSize="26" Foreground="#93A38A" HorizontalAlignment="Center" />
                <TextBlock Text="NO LIVE CAMERA — CONNECT A WEBCAM" FontSize="11" Foreground="#728271" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="OR OPEN A PHOTO / VIDEO TO DEVELOP" FontSize="10" Foreground="#647365" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Grid.Row="2" x:Name="SelectedProfileText" Text="VGA 2001  /  CMOS SNAPSHOT" HorizontalAlignment="Center" Foreground="#C4D7A2" FontSize="11" Margin="0,12,0,3" />
          <Button Grid.Row="3" x:Name="CaptureButton" Content="◎   TAKE PHOTO" Height="57" FontSize="17" Background="#B7D96C" Foreground="#1A241A" Margin="38,5,38,8" Click="CaptureButton_Click" />
          <StackPanel Grid.Row="4">
            <TextBlock Text="CHOOSE CAMERA ↓" FontSize="10" Foreground="#8FA08A" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <WrapPanel HorizontalAlignment="Center">
              <Button Content="VGA 2001" Tag="VGA_2001" Click="SelectCamera_Click" />
              <Button Content="CCD 2005" Tag="CCD_2005" Click="SelectCamera_Click" />
              <Button Content="FILM 1996" Tag="FILM_1996" Click="SelectCamera_Click" />
              <Button Content="TOY 1988" Tag="TOY_1988" Click="SelectCamera_Click" />
              <Button Content="NIGHT 2003" Tag="NIGHT_2003" Click="SelectCamera_Click" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#202B29" BorderBrush="#52624F" BorderThickness="1" CornerRadius="18" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="CAMERA CONTROLS" Foreground="#B7D96C" FontSize="12" Margin="4,3,4,14" />
            <TextBlock Text="CAPTURE MODE" Foreground="#91A18C" FontSize="10" />
            <UniformGrid Columns="2" Margin="0,3,0,12">
              <Button x:Name="PhotoModeButton" Content="PHOTO" Background="#B7D96C" Foreground="#1A241A" Click="PhotoMode_Click" />
              <Button x:Name="VideoModeButton" Content="VIDEO" Click="VideoMode_Click" />
            </UniformGrid>

            <TextBlock Text="OUTPUT RESOLUTION / MP" Foreground="#91A18C" FontSize="10" />
            <ComboBox x:Name="ResolutionCombo" SelectedIndex="0">
              <ComboBoxItem Content="0.3 MP   •  640 × 480" />
              <ComboBoxItem Content="0.5 MP   •  800 × 600" />
              <ComboBoxItem Content="0.8 MP   •  1024 × 768" />
              <ComboBoxItem Content="1.2 MP   •  1280 × 960" />
              <ComboBoxItem Content="1.9 MP   •  1600 × 1200" />
            </ComboBox>

            <Separator Background="#465449" Margin="4,15" />
            <TextBlock Text="IMPORT FROM THIS PC" Foreground="#91A18C" FontSize="10" />
            <Button Content="OPEN PHOTO / PROCESS" Click="ImportPhoto_Click" HorizontalAlignment="Stretch" />
            <Button Content="OPEN VIDEO / PROCESS" Click="ImportVideo_Click" HorizontalAlignment="Stretch" />

            <Separator Background="#465449" Margin="4,15" />
            <TextBlock Text="CAMERA OPTIONS" Foreground="#91A18C" FontSize="10" />
            <CheckBox x:Name="DateStampCheck" Content="Date stamp (amber LCD)" IsChecked="True" Foreground="#DCE6CF" Margin="8,10" />
            <CheckBox x:Name="FlashCheck" Content="Flash / torch (if supported)" Foreground="#DCE6CF" Margin="8,5" Checked="FlashCheck_Changed" Unchecked="FlashCheck_Changed" />
            <TextBlock Text="OUTPUT FOLDERS" Foreground="#91A18C" FontSize="10" Margin="4,14,4,2" />
            <TextBlock Text="Pictures\\PocketRetro\\Photos" Foreground="#BACAAE" FontSize="10" Margin="8,2" TextWrapping="Wrap" />
            <TextBlock Text="Videos\\PocketRetro" Foreground="#BACAAE" FontSize="10" Margin="8,2" />
            <TextBlock Text="All processing is local. Original files are not overwritten." Foreground="#758674" FontSize="10" Margin="4,14,4,6" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#17211F" CornerRadius="8" Padding="10,5" Margin="0,10,0,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="READY // CONNECT A WEBCAM OR OPEN A FILE" FontSize="10" Foreground="#A9BA9A" VerticalAlignment="Center" />
        <TextBlock Text="POCKETRETRO 1.0" DockPanel.Dock="Right" FontSize="10" Foreground="#617563" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
