<Application x:Class="PocketRetro.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CaseBrush" Color="#202B29" />
    <SolidColorBrush x:Key="ScreenBrush" Color="#101918" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B7D96C" />
    <SolidColorBrush x:Key="TextBrush" Color="#DCE6CF" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#2B3933" />
      <Setter Property="BorderBrush" Value="#596A56" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3B4B40" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="4,6" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Background" Value="#18221F" />
      <Setter Property="Foreground" Value="#18221F" />
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
  </Application.Resources>
</Application>
